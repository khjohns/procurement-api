        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fileName": {
                    "type": "string"
                  },
                  "fileContent": {
                    "type": "string",
                    "description": "Base64 encoded file content"
                  }
