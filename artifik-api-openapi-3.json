          }
        },
        "responses": {
          "201": {
            "description": "File uploaded successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Contract not found"
          }
        }
      }
    },
    "/external/tasks": {
      "get": {
        "summary": "Get tasks",
        "description": "Get tasks filtered by organization, user, status, and/or type.",
        "operationId": "ExternalAPIController_getTasks",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "organizationId",
            "in": "query",
            "description": "Filter by organization ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "description": "Filter by user ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status (comma-separated: pending,in_progress,completed)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Filter by task type",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of tasks"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
