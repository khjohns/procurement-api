{
  "openapi": "3.0.0",
  "info": {
    "title": "Artifik External API",
    "description": "OAuth2 API for third-party automation and integration",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://api.artifik.no"
    }
  ],
  "security": [
    {
      "oauth2": []
    }
  ],
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api.artifik.no/external/token",
            "scopes": {}
          }
        }
      }
    }
  },
  "paths": {
    "/external/token": {
      "post": {
        "summary": "Get OAuth2 access token",
        "description": "Authenticate using client credentials to obtain an access token. Send client_id and client_secret in the request body with grant_type=client_credentials.",
        "operationId": "ExternalAPIController_getSessionToken",
        "tags": ["External API"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["grant_type", "client_id", "client_secret"],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "example": "client_credentials"
                  },
                  "client_id": {
                    "type": "string",
                    "example": "your-client-id"
                  },
                  "client_secret": {
                    "type": "string",
                    "example": "your-client-secret"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token issued successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string",
                      "example": "Bearer"
                    },
                    "expires_in": {
                      "type": "integer",
                      "example": 3600
                    },
                    "scope": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/external/procurements": {
      "get": {
        "summary": "List procurements",
        "description": "Get all procurements accessible to the authenticated client. Global OAuth keys require organizationId parameter.",
        "operationId": "ExternalAPIController_getProcurements",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "organizationId",
            "in": "query",
            "description": "Filter by organization ID (to specify sub-org for OAuth keys with access to more than one organization)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of procurements"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/external/{procurement_id}/archiveZip": {
      "get": {
        "summary": "Download procurement archive as ZIP",
        "description": "Downloads all procurement documents as a ZIP file.",
        "operationId": "ExternalAPIController_getZipForArchive",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "procurement_id",
            "in": "path",
            "description": "The procurement ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ZIP file stream"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Procurement not found"
          }
        }
      }
    },
    "/external/{procurement_id}/activities": {
      "get": {
        "summary": "Get activities for a procurement",
        "description": "Returns audit log of activities for a specific procurement.",
        "operationId": "ExternalAPIController_getActivitiesForProcurement",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "procurement_id",
            "in": "path",
            "description": "The procurement ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of activities"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "No access to procurement"
          }
        }
      }
    },
    "/external/activities": {
      "get": {
        "summary": "Get activities for an organization",
        "description": "Returns audit log of all activities for an organization.",
        "operationId": "ExternalAPIController_getActivitiesForOrganization",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "limitDate",
            "in": "query",
            "description": "Filter activities after this date",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "organizationId",
            "in": "query",
            "description": "Organization ID (required for global/user OAuth keys)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of activities"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/external/webhooks": {
      "get": {
        "summary": "List webhooks",
        "description": "List all registered webhooks for the organization.",
        "operationId": "ExternalAPIController_listWebhooks",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "organizationId",
            "in": "query",
            "description": "Organization ID (to specify sub-org for OAuth keys with access to more than one organization)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of webhooks"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "summary": "Register a webhook",
        "description": "Register a new webhook to receive notifications for specified actions. The webhook will be called when events occur.",
        "operationId": "ExternalAPIController_registerWebhook",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "organizationId",
            "in": "query",
            "description": "Organization ID (required for global/user OAuth keys)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "callbackURL": {
                    "type": "string",
                    "example": "https://your-site.com/webhook.php"
                  },
                  "actionList": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "ADD_BUYER", "ADD_FILES", "ASK_TO_QUALIFY", "AWARDING_PARTICIPANTS",
                        "CANCEL_BID", "CANCEL_PROCUREMENT", "CREATE_CONTRACT", "CREATE_TENDER",
                        "DELETE_FILE", "EDIT_SMART_DOCUMENT", "INVITATIONS_SENT",
                        "INVITATIONS_TO_NEGOTIATE_SENT", "INVITE_SUBCONTRACTORS",
                        "LOGIN_SUCCESSFUL", "LOGIN_UNSUCCESSFUL", "OPEN_BIDS",
                        "OPEN_QUALIFICATIONS", "PUBLISH_ADDITIONAL_INFORMATION", "PUBLISH_Q8A",
                        "PUBLISH_TO_DOFFIN", "QUALIFYING_PARTICIPANTS", "REJECT_PARTICIPATION",
                        "REMOVE_BUYER", "REVIEW_NOTICE_TRANSLATIONS", "SUBMIT_BID",
                        "UPDATE_FILES", "UPDATE_NOTICE_TRANSLATIONS", "UPDATE_PROCUREMENT",
                        "UPDATE_TENDER", "UPDATE_TIMELINE", "WITHDRAW_PARTICIPATION"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Webhook registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "webhookId": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/external/webhooks/{id}": {
      "delete": {
        "summary": "Delete a webhook",
        "description": "Delete an existing webhook. To edit a webhook, delete it and create a new one.",
        "operationId": "ExternalAPIController_deleteWebhook",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The webhook ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook deleted successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Webhook not found"
          }
        }
      }
    },
    "/external/{procurement_id}/smartDocResponses": {
      "get": {
        "summary": "Get Smart Document responses",
