        "parameters": [
          {
            "name": "procurement_id",
            "in": "path",
            "description": "The procurement ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Smart Document responses"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "No access"
          }
        }
      }
    },
    "/external/{procurement_id}/smartDocResponsesAsExcel": {
      "get": {
        "summary": "Get Smart Document responses as Excel",
        "description": "Download Smart Document responses as an Excel file.",
        "operationId": "ExternalAPIController_getMainSmartDocResponsesForProcurementAsExcelFile",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "procurement_id",
            "in": "path",
            "description": "The procurement ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Redirects to Excel file download"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/external/{procurement_id}/smartDocResponsesAsPDFZip": {
      "get": {
        "summary": "Get Smart Document responses as PDF ZIP",
        "description": "Download Smart Document responses as individual PDFs in a ZIP file.",
        "operationId": "ExternalAPIController_getMainSmartDocResponsesForProcurementAsPDFsInZipFile",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "procurement_id",
            "in": "path",
            "description": "The procurement ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Redirects to ZIP file download"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/external/contracts": {
      "get": {
        "summary": "List contracts",
        "description": "Get all contracts for the organization with optional custom fields.",
        "operationId": "ExternalAPIController_getContracts",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "organizationId",
            "in": "query",
            "description": "Organization ID (to specify sub-org for OAuth keys with access to more than one organization)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeCustomFields",
            "in": "query",
            "description": "Include custom fields in response (1, true, or false)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limitDate",
            "in": "query",
            "description": "ISO date, gets only contracts newer than this date",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of contracts"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/external/contracts/{contract_id}": {
      "get": {
        "summary": "Get contract by ID",
        "description": "Get a specific contract by ID. For framework agreements, includes sub-folder contracts for supplier-specific files.",
        "operationId": "ExternalAPIController_getContract",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "contract_id",
            "in": "path",
            "description": "The contract ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contract details"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Contract not found"
          }
        }
      }
    },
    "/external/organization/{organization_id}": {
      "post": {
        "summary": "Create organization with custom ID",
        "description": "Create a new organization with a custom ID. Can create root organizations or sub-organizations.",
        "operationId": "ExternalAPIController_createOrganizationWithId",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "description": "Custom organization ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "parentOrganizationId",
            "in": "query",
            "description": "Parent organization ID for creating sub-organizations",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Organization created successfully"
          },
          "400": {
            "description": "Organization already exists or validation error"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/external/organizations": {
      "get": {
        "summary": "List all organizations",
        "description": "List all organizations. Only available to global OAuth keys.",
        "operationId": "ExternalAPIController_listOrganizations",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "includeSubOrgs",
            "in": "query",
            "description": "Include sub-organizations (use 1 for true)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "parentId",
            "in": "query",
            "description": "Filter by parent organization ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of organizations"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Only global OAuth clients can list organizations"
          }
        }
      }
    },
    "/external/organization": {
      "post": {
        "summary": "Create organization",
        "description": "Create a new organization with auto-generated ID.",
        "operationId": "ExternalAPIController_createOrganization",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "parentOrganizationId",
            "in": "query",
            "description": "Parent organization ID for creating sub-organizations",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Organization created successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/external/organization/{organization_id}/members": {
      "post": {
        "summary": "Add organization member",
        "description": "Add a member to an organization. Creates the user if they do not exist. Can specify password for new users.",
        "operationId": "ExternalAPIController_addOrganizationMember",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "description": "Organization ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["viewer", "editor", "admin", "contributor"]
                  },
                  "password": {
                    "type": "string",
                    "description": "Optional - often skipped for SSO or SMS OTP login"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Member added successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Not authorized to manage members"
          }
        }
      },
      "put": {
        "summary": "Update organization member email",
        "description": "Update a member's email address.",
        "operationId": "ExternalAPIController_updateOrganizationMember",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "description": "Organization ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Member updated successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Not authorized to manage members"
          }
        }
      }
    },
    "/external/organization/{organization_id}/members/{member_email}": {
      "delete": {
        "summary": "Remove organization member",
        "description": "Remove a member from an organization.",
        "operationId": "ExternalAPIController_removeOrganizationMember",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "description": "Organization ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "member_email",
            "in": "path",
            "description": "Member email address",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Member removed successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Not authorized or cannot remove last admin"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/external/{organization_id}/members": {
      "get": {
