          {
            "name": "organization_id",
            "in": "path",
            "description": "Organization ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeSubOrgs",
            "in": "query",
            "description": "Include members from sub-organizations (use 1 for true)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of members"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Not authorized to view members"
          }
        }
      }
    },
    "/external/organization/{organization_id}/contracts": {
      "post": {
        "summary": "Create contract",
        "description": "Create a new contract (standalone or framework agreement) for an organization.",
        "operationId": "ExternalAPIController_createContract",
        "tags": ["External API"],
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "description": "Organization ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "supplierOrgName": {
                    "type": "string"
                  },
                  "duration": {
                    "type": "string",
                    "enum": ["range", "months", "days", "open_end"],
                    "description": "Duration type: range (with start/end dates), months, days, or open_end"
                  },
                  "startDate": {
                    "type": "string",
                    "format": "date"
                  },
                  "endDate": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contract created successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Not authorized to create contracts"
          }
        }
      }
    },
    "/external/contracts/{contract_id}/files": {
